<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="movie_rating_backend.mapper.CommentMapper">

    <!-- 调用存储过程：按电影名查评论 -->
    <select id="findCommentsByMovieTitle" parameterType="string" statementType="CALLABLE"
            resultType="map">
        {call sp_query_comments_by_movie(#{title, mode=IN, jdbcType=VARCHAR})}
    </select>

    <!-- 查询某用户的所有评论（带电影标题） -->
    <select id="getUserComments" resultType="movie_rating_backend.entity.MovieComment">
        SELECT m.*, c.CommentID, c.UserID, c.Content, c.CommentTime
        FROM comment1707 c
        JOIN movie1707 m ON c.MovieID = m.MovieID
        WHERE c.UserID = #{userId}
        ORDER BY c.CommentTime DESC
    </select>

    <!-- 查询某电影的所有评论并关联用户名 -->
    <select id="getMovieCommentsWithUsername" resultType="movie_rating_backend.entity.Comment">
        SELECT c.*, u.Username
        FROM comment1707 c
        LEFT JOIN user1707 u ON c.UserID = u.UserID
        WHERE c.MovieID = #{movieId}
        ORDER BY c.CommentTime DESC
    </select>

</mapper>
