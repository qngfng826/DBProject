# 复制本文件为 .env 并填入真实值（.env 已被 .gitignore 忽略，不会入库）
# docker compose 会自动读取根目录 .env

# MySQL 容器 root 密码（仅容器内数据库使用，与本机 MySQL96/84 无关）
MYSQL_ROOT_PASSWORD=change-me

# JWT 签名密钥（至少 32 字符，可用 openssl rand -hex 32 生成）
JWT_SECRET=change-me

# 热点缓存开关：A/B 压测基线时改为 false 后 docker compose up -d backend 重建
CACHE_ENABLED=true
